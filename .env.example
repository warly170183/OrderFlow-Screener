# Copy to .env.local and fill in. Never commit real keys.

# Finnhub key for the FX feed (browser-exposed; use a restricted key).
NEXT_PUBLIC_FINNHUB_API_KEY=

# Public URL of the deployment, used for canonical links and absolute
# Open Graph / Twitter image URLs. Optional on Vercel (detected automatically).
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ── Screener service (npm run server) ────────────────────────
# All optional. Defaults shown.
# HOST=127.0.0.1                 # bind address; keep loopback unless you add API_TOKEN and TLS
# PORT=8787
# DATA_DIR=./data                # events.jsonl + tracker.json
# SYMBOL_LIMIT=40                # top-N OKX perpetuals by 24h notional
# SYMBOLS=BTC,ETH,SOL            # explicit list; overrides SYMBOL_LIMIT and CATEGORIES
# CATEGORIES=1,4                 # OKX instCategory: 1 crypto, 3 stocks/pre-IPO, 4 commodities
# MIN_SCORE=60                   # signal threshold (0-100)
# COOLDOWN_MIN=10                # mute same symbol+direction after a signal
# WARMUP_MIN=5                   # minutes of history before a symbol may signal
# MIN_VOLUME_1M_USD=20000        # ignore symbols trading less than this per minute
# API_TOKEN=                     # bearer token required by the API when set
# ALLOWED_ORIGIN=http://localhost:3000   # CORS origin of the web app
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# WEBHOOK_URL=                   # receives JSON {text, kind, signal|tracked}
# DEMO=1                         # synthetic data, no exchange access (not real prices)

# Web app → service (bundled into the browser build; do not put a secret token here
# on a public deployment).
# NEXT_PUBLIC_SCREENER_URL=http://localhost:8787
# NEXT_PUBLIC_SCREENER_TOKEN=
